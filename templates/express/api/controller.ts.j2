{% set parse_id_fn = '_parseStringId' if entity.pk_ts_type == 'string' else '_parseId' %}
import { Request, Response, NextFunction } from 'express';
import { I{{ entity.name }}Service } from '../contracts/{{ entity.name_lower }}.service.contract.js';
import { validate{{ entity.name }}Create, validate{{ entity.name }}Update } from '../validators/{{ entity.name_lower }}.validator.js';
import { parseListQuery, buildPaginatedResponse } from '../lib/pagination.js';
import { AppError } from '../lib/errors.js';
{% for nested in nested_routes %}
import { I{{ nested.related_entity }}Service } from '../contracts/{{ nested.related_entity_lower }}.service.contract.js';
import { validate{{ nested.related_entity }}Create{% if nested.has_parent_fk_schema %}, validate{{ nested.related_entity }}CreateNested{% endif %} } from '../validators/{{ nested.related_entity_lower }}.validator.js';
{% endfor %}

export class {{ entity.name }}Controller {
  constructor(
    private readonly service: I{{ entity.name }}Service{% if nested_routes %},{% endif %}
{% for nested in nested_routes %}
    private readonly {{ nested.related_entity_lower }}Service: I{{ nested.related_entity }}Service{% if not loop.last %},{% endif %}
{% endfor %}
  ) {}

  private readonly ALLOWED_FILTER_FIELDS = [{% for f in filterable_fields %}'{{ f.name }}'{% if not loop.last %}, {% endif %}{% endfor %}] as const;
  private readonly ALLOWED_SORT_FIELDS = [{% for f in sortable_fields %}'{{ f.name }}'{% if not loop.last %}, {% endif %}{% endfor %}] as const;

  async getAll(req: Request, res: Response, next: NextFunction): Promise<void> {
    try {
      const params = parseListQuery(req, this.ALLOWED_FILTER_FIELDS, this.ALLOWED_SORT_FIELDS);
      const { data, total } = await this.service.list(params);
      res.json(buildPaginatedResponse(data, total, params));
    } catch (err) {
      next(err);
    }
  }

  async getById(req: Request, res: Response, next: NextFunction): Promise<void> {
    try {
      const id = this.{{ parse_id_fn }}(req.params.id);
      const record = await this.service.getById(id);
      res.json(record);
    } catch (err) {
      next(err);
    }
  }

  async create(req: Request, res: Response, next: NextFunction): Promise<void> {
    try {
      const data = validate{{ entity.name }}Create(req.body);
      const record = await this.service.create(data, req.user?.id);
      res.status(201).json(record);
    } catch (err) {
      next(err);
    }
  }

  async update(req: Request, res: Response, next: NextFunction): Promise<void> {
    try {
      const id = this.{{ parse_id_fn }}(req.params.id);
      const data = validate{{ entity.name }}Update(req.body);
      const record = await this.service.update(id, data, req.user?.id);
      res.json(record);
    } catch (err) {
      next(err);
    }
  }

  async remove(req: Request, res: Response, next: NextFunction): Promise<void> {
    try {
      const id = this.{{ parse_id_fn }}(req.params.id);
      await this.service.remove(id, req.user?.id);
      res.status(204).send();
    } catch (err) {
      next(err);
    }
  }
{% for nested in nested_routes %}

  // --- Nested: {{ nested.related_entity }} under {{ entity.name }} ---

  async get{{ nested.related_entity }}sFor{{ entity.name }}(req: Request, res: Response, next: NextFunction): Promise<void> {
    try {
      const parentId = this.{{ parse_id_fn }}(req.params.id);
      const nestedFilterFields = [{% for f in nested.filterable_fields %}'{{ f.name }}'{% if not loop.last %}, {% endif %}{% endfor %}] as const;
      const nestedSortFields = [{% for f in nested.sortable_fields %}'{{ f.name }}'{% if not loop.last %}, {% endif %}{% endfor %}] as const;
      const params = parseListQuery(req, nestedFilterFields, nestedSortFields);
      const { data, total } = await this.{{ nested.related_entity_lower }}Service.listBy{{ nested.fk_field[0] | upper ~ nested.fk_field[1:] }}(parentId, params);
      res.json(buildPaginatedResponse(data, total, params));
    } catch (err) {
      next(err);
    }
  }
{% if nested.is_primary_parent %}

  async create{{ nested.related_entity }}For{{ entity.name }}(req: Request, res: Response, next: NextFunction): Promise<void> {
    try {
{% if entity.is_auth_entity %}
      // Parent ID comes from the authenticated user's token, not the URL
      const parentId = req.user!.id;
{% else %}
      const parentId = this.{{ parse_id_fn }}(req.params.id);
{% endif %}
{% if nested.use_nested_schema %}
      // Use the nested schema: parent FK ({{ nested.fk_field }}) is injected from URL, not expected in body
      const data = validate{{ nested.related_entity }}CreateNested(req.body);
{% else %}
      const data = validate{{ nested.related_entity }}Create(req.body);
{% endif %}
      const record = await this.{{ nested.related_entity_lower }}Service.createFor{{ entity.name }}(parentId, data, req.user?.id);
      res.status(201).json(record);
    } catch (err) {
      next(err);
    }
  }
{% endif %}

{% endfor %}

{% if entity.pk_ts_type == 'string' %}
  private _parseStringId(raw: string): string {
    if (!raw || raw.trim() !== raw || raw.length > 128) {
      throw new AppError(400, 'Invalid ID format');
    }
{% if entity.pk_strategy == 'uuid' %}
    // UUID v4 format validation
    if (!/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(raw)) {
      throw new AppError(400, 'Invalid ID format');
    }
{% elif entity.pk_strategy == 'cuid' %}
    // CUID format validation (starts with 'c', followed by alphanumeric)
    if (!/^c[a-z0-9]{20,}$/.test(raw)) {
      throw new AppError(400, 'Invalid ID format');
    }
{% endif %}
    return raw;
  }
{% else %}
  private _parseId(raw: string): number {
    if (!/^\d+$/.test(raw)) {
      throw new AppError(400, 'Invalid ID format');
    }
    const id = Number(raw);
    if (id > Number.MAX_SAFE_INTEGER) {
      throw new AppError(400, 'ID out of range');
    }
    return id;
  }
{% endif %}
}
