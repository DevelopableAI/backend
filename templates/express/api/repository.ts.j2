import { prisma } from '../lib/prisma.js';
import { ListQueryParams } from '../lib/pagination.js';
import { I{{ entity.name }}Repository } from '../contracts/{{ entity.name_lower }}.repository.contract.js';
import { {{ entity.name }}PersistenceCreateInput, {{ entity.name }}Record, {{ entity.name }}Response, {{ entity.name }}UpdateInput } from '../types/{{ entity.name_lower }}.types.js';
{% set sensitive_fields = entity.fields | selectattr('is_sensitive') | list %}

{% set has_safe_select = sensitive_fields | length > 0 %}

export class {{ entity.name }}Repository implements I{{ entity.name }}Repository {
{% if has_safe_select %}
  // Sensitive fields are excluded from all read responses
  private readonly safeSelect = {
{% for field in entity.fields if not field.is_relation %}
    {{ field.name }}: {{ 'false' if field.is_sensitive else 'true' }},
{% endfor %}
  } as const;

{% endif %}
  async findMany(
    params: ListQueryParams,
  ): Promise<{ data: {{ entity.name }}Response[]; total: number }> {
    const where: any = {};
{% for field in filterable_fields %}
    if (params.filters['{{ field.name }}'] !== undefined) {
{% if field.ts_type == 'number' %}
      const _v{{ loop.index }} = Number(params.filters['{{ field.name }}']);
      if (!isNaN(_v{{ loop.index }})) where['{{ field.name }}'] = _v{{ loop.index }};
{% elif field.ts_type == 'boolean' %}
      where['{{ field.name }}'] = params.filters['{{ field.name }}'] === 'true';
{% elif field.is_enum %}
      const _valid{{ loop.index }}: string[] = [{{ field.enum_values | map('tojson') | join(', ') }}];
      if (_valid{{ loop.index }}.includes(params.filters['{{ field.name }}'] as string))
        where['{{ field.name }}'] = params.filters['{{ field.name }}'];
      else
        where['{{ field.name }}'] = { in: [] };
{% else %}
      where['{{ field.name }}'] = params.filters['{{ field.name }}'];
{% endif %}
    }
{% endfor %}
    const orderBy: any = params.sort
      ? { [params.sort.field]: params.sort.order }
      : { {% set id_field = entity.fields | selectattr('is_id') | first %}{{ id_field.name if id_field else 'id' }}: 'desc' };
    const [data, total] = await prisma.$transaction([
      prisma.{{ entity.name_lower }}.findMany({
        where,
        skip: params.skip,
        take: params.limit,
        orderBy,
{% if has_safe_select %}
        select: this.safeSelect,
{% endif %}
      }),
      prisma.{{ entity.name_lower }}.count({ where }),
    ]);

    return { data, total };
  }

  async findById(id: {{ entity.pk_ts_type }}): Promise<{{ entity.name }}Response | null> {
    return prisma.{{ entity.name_lower }}.findUnique({
      where: { {% set id_field = entity.fields | selectattr('is_id') | first %}{{ id_field.name if id_field else 'id' }}: id },
{% if has_safe_select %}
      select: this.safeSelect,
{% endif %}
    });
  }

  async create(data: {{ entity.name }}PersistenceCreateInput): Promise<{{ entity.name }}Response> {
    return prisma.{{ entity.name_lower }}.create({
      // Cast to any: custom type name clashes with Prisma's checked variant; scalar FKs resolve correctly at runtime.
      data: data as any,
{% if has_safe_select %}
      select: this.safeSelect,
{% endif %}
    });
  }

  async update(id: {{ entity.pk_ts_type }}, data: {{ entity.name }}UpdateInput): Promise<{{ entity.name }}Response | null> {
    try {
      return await prisma.{{ entity.name_lower }}.update({
        where: { {% set id_field = entity.fields | selectattr('is_id') | first %}{{ id_field.name if id_field else 'id' }}: id },
        // Cast to any: see create() comment above.
        data: data as any,
{% if has_safe_select %}
        select: this.safeSelect,
{% endif %}
      });
    } catch (err: any) {
      if (err.code === 'P2025') return null;
      throw err;
    }
  }

  async delete(id: {{ entity.pk_ts_type }}): Promise<boolean> {
{% set id_field = entity.fields | selectattr('is_id') | first %}
    try {
{% if child_cascade_deletes %}
      // Delete child records first to avoid FK constraint violations, then delete this entity.
      await prisma.$transaction([
{% for child in child_cascade_deletes %}
        prisma.{{ child.child_name_lower }}.deleteMany({ where: { {{ child.fk_field }}: id } }),
{% endfor %}
        prisma.{{ entity.name_lower }}.delete({ where: { {{ id_field.name if id_field else 'id' }}: id } }),
      ]);
{% else %}
      await prisma.{{ entity.name_lower }}.delete({
        where: { {{ id_field.name if id_field else 'id' }}: id },
      });
{% endif %}
      return true;
    } catch (err: any) {
      if (err.code === 'P2025') return false;
      throw err;
    }
  }
{% for rel in parent_fk_relations %}
{% set fk_field_obj = entity.fields | selectattr('name', 'equalto', rel.fk_field) | first %}
  // Find all {{ entity.name_plural }} belonging to a parent via {{ rel.fk_field }}
  async findManyBy{{ rel.fk_field[0] | upper ~ rel.fk_field[1:] }}(
    parentId: {{ fk_field_obj.ts_type if fk_field_obj else entity.pk_ts_type }},
    params: ListQueryParams,
  ): Promise<{ data: {{ entity.name }}Response[]; total: number }> {
    const where: any = { {{ rel.fk_field }}: parentId };
{% for field in filterable_fields %}
    if (params.filters['{{ field.name }}'] !== undefined) {
{% if field.ts_type == 'number' %}
      const _v{{ loop.index }} = Number(params.filters['{{ field.name }}']);
      if (!isNaN(_v{{ loop.index }})) where['{{ field.name }}'] = _v{{ loop.index }};
{% elif field.ts_type == 'boolean' %}
      where['{{ field.name }}'] = params.filters['{{ field.name }}'] === 'true';
{% elif field.is_enum %}
      const _valid{{ loop.index }}: string[] = [{{ field.enum_values | map('tojson') | join(', ') }}];
      if (_valid{{ loop.index }}.includes(params.filters['{{ field.name }}'] as string))
        where['{{ field.name }}'] = params.filters['{{ field.name }}'];
      else
        where['{{ field.name }}'] = { in: [] };
{% else %}
      where['{{ field.name }}'] = params.filters['{{ field.name }}'];
{% endif %}
    }
{% endfor %}
    const orderBy: any = params.sort
      ? { [params.sort.field]: params.sort.order }
      : { {% set id_field = entity.fields | selectattr('is_id') | first %}{{ id_field.name if id_field else 'id' }}: 'desc' };
    const [data, total] = await prisma.$transaction([
      prisma.{{ entity.name_lower }}.findMany({
        where,
        skip: params.skip,
        take: params.limit,
        orderBy,
{% if has_safe_select %}
        select: this.safeSelect,
{% endif %}
      }),
      prisma.{{ entity.name_lower }}.count({ where }),
    ]);

    return { data, total };
  }
{% endfor %}
{% if entity.is_auth_entity and entity.auth_login_field %}

  async findAuthByLogin(loginValue: {{ entity.auth_login_field.ts_type }}): Promise<{{ entity.name }}Record | null> {
{% if entity.auth_login_field.is_unique or entity.auth_login_field.is_id %}
    return prisma.{{ entity.name_lower }}.findUnique({
      where: { {{ entity.auth_login_field.name }}: loginValue },
    });
{% else %}
    return prisma.{{ entity.name_lower }}.findFirst({
      where: { {{ entity.auth_login_field.name }}: loginValue },
    });
{% endif %}
  }
{% endif %}
}
